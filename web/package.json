{
  "name": "blirp-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "screenshots": "vite build && node --experimental-strip-types e2e/screenshots.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "@xterm/addon-clipboard": "0.3.0-beta.303",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-search": "0.17.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
